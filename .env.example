# Server-only Supabase credentials (collector + dashboard server routes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase Auth configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTHORIZED_EMAILS=your-google-account@gmail.com

# Optional dashboard-triggered GitHub Action
GITHUB_REPOSITORY=owner/repository
GITHUB_DISPATCH_TOKEN=

# AI: rules | gemini | copilot | both | auto
AI_MODE=auto
AI_REVIEW_MIN_SCORE=45
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
COPILOT_GITHUB_TOKEN=

# Free-first notification stack
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

AGENT_REACH_ENABLED=false

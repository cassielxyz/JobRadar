# Server-only Supabase credentials (collector + dashboard server routes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase Auth configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTHORIZED_EMAILS=your-google-account@gmail.com

# Optional dashboard-triggered GitHub Action (Vercel/server only)
GITHUB_REPOSITORY=owner/repository
GITHUB_DISPATCH_TOKEN=

# AI fallback values: dashboard Integrations can override Gemini values.
# AI: rules | gemini | copilot | both | auto
AI_MODE=auto
AI_REVIEW_MIN_SCORE=45
DASHBOARD_MIN_SCORE=55
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional only when you explicitly use a separate Copilot PAT locally.
COPILOT_GITHUB_TOKEN=

# Notification fallback values: dashboard Integrations can override these at runtime.
# Free notification stack
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Optional hidden-web discovery. GitHub Actions installs Agent Reach when true.
AGENT_REACH_ENABLED=true

# Safe auto-apply runner (GitHub repository variable, keep false until profile is reviewed)
AUTO_APPLY_RUNNER_ENABLED=false
